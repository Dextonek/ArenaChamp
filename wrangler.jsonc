// Cloudflare deployment of Arena of Kits (the duel game) and the editor: worker/index.mjs serves dist/ and runs the
// game server in a Durable Object. See docs/architecture/multiplayer.md#cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arena-of-kits",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  // node:crypto's scrypt, only for accounts made by the old Node server (none exist on Cloudflare).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /ws and the redirect at / go to the Worker; every other path is a file from dist/.
    "run_worker_first": ["/ws", "/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "GameHub" }]
  },
  // SQLite-backed Durable Object (available on the Workers free plan).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameHub"] }],
  "dev": { "port": 8788 }
}
